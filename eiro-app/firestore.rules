rules_version = '2';
// EIRO Robotics Competition Platform — Firestore Security Rules
// Last updated: 2026-10-21
// IMPORTANT: Sensitive writes (payments, score locks, qualification, adjustments)
// must go through trusted Cloud Functions only. These rules enforce read authorization.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roleAssignments/$(uid() + '_' + role)) &&
        get(/databases/$(database)/documents/roleAssignments/$(uid() + '_' + role)).data.active == true;
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isDistrictAdmin() {
      return hasRole('DISTRICT_ADMIN') || isSuperAdmin();
    }

    function isVenueCoordinator() {
      return hasRole('VENUE_COORDINATOR') || isDistrictAdmin();
    }

    function isSchoolCoordinator(schoolId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roleAssignments/$(uid() + '_SCHOOL_COORDINATOR')) &&
        get(/databases/$(database)/documents/roleAssignments/$(uid() + '_SCHOOL_COORDINATOR')).data.active == true &&
        get(/databases/$(database)/documents/roleAssignments/$(uid() + '_SCHOOL_COORDINATOR')).data.scopeId == schoolId;
    }

    function isJudge() {
      return hasRole('JUDGE') || hasRole('HEAD_JUDGE') || isDistrictAdmin();
    }

    function isHeadJudge() {
      return hasRole('HEAD_JUDGE') || isDistrictAdmin();
    }

    function isCheckinVolunteer() {
      return hasRole('CHECKIN_VOLUNTEER') || isVenueCoordinator();
    }

    // Check role assignment doc directly (more scalable pattern)
    function hasActiveRoleAssignment(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roleAssignments/$(uid() + '_' + role)) &&
        get(/databases/$(database)/documents/roleAssignments/$(uid() + '_' + role)).data.active == true;
    }

    // ─── Public read collections ──────────────────────────────────────────────

    // Published seasons, categories, rule versions — public read
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /categories/{categoryCode} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /ruleVersions/{versionId} {
      allow read: if resource.data.status == 'PUBLISHED' || isDistrictAdmin();
      allow write: if isSuperAdmin();
    }

    match /districts/{districtId} {
      allow read: if true;
      // District admins can edit their own district (e.g., add venues)
      allow write: if isDistrictAdmin() || isSuperAdmin();
    }

    match /venues/{venueId} {
      allow read: if true;
      // Super admin can also manage venues
      allow write: if isDistrictAdmin() || isSuperAdmin();
    }

    // Published events — public read only for published state
    match /events/{eventId} {
      allow read: if resource.data.state == 'PUBLISHED' ||
                     resource.data.state == 'ACTIVE' ||
                     resource.data.state == 'COMPLETED' ||
                     isVenueCoordinator();
      allow write: if isDistrictAdmin();
    }

    // Published results — public read only after publication
    match /results/{resultId} {
      allow read: if resource.data.publishedAt != null || isDistrictAdmin();
      allow write: if false; // Cloud Functions only
    }

    // Certificate public verification — expose minimal fields
    match /certificates/{certId} {
      allow read: if resource.data.status == 'ACTIVE'; // public verify by code
      allow write: if false; // Cloud Functions only
    }

    // ─── User profiles ────────────────────────────────────────────────────────

    match /users/{userId} {
      allow get:    if uid() == userId || isSuperAdmin();
      allow list:   if isSuperAdmin();             // admin staff page
      allow create: if uid() == userId;            // self-register
      allow update: if uid() == userId || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /roleAssignments/{assignmentId} {
      allow get:  if isAuthenticated() && (
        resource == null || resource.data.uid == uid() || isDistrictAdmin()
      );
      allow list: if isSuperAdmin();               // admin staff page: load all assignments
      // Super admin can write any role
      allow write: if isSuperAdmin();
      // New users may self-assign SCHOOL_COORDINATOR only (default role on signup)
      allow create: if isAuthenticated()
        && assignmentId == uid() + '_SCHOOL_COORDINATOR'
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'SCHOOL_COORDINATOR'
        && request.resource.data.active == true;
    }

    // ─── Schools ──────────────────────────────────────────────────────────────

    match /schools/{schoolId} {
      allow read: if isAuthenticated() && (
        isSchoolCoordinator(schoolId) || isDistrictAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isSchoolCoordinator(schoolId) || isDistrictAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Students ─────────────────────────────────────────────────────────────

    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        // School coordinator can only read own school's students
        isSchoolCoordinator(resource.data.schoolId) || isDistrictAdmin()
      );
      allow create: if isAuthenticated() &&
        isSchoolCoordinator(request.resource.data.schoolId) &&
        getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.schoolId ==
          request.resource.data.schoolId;
      allow update: if isSchoolCoordinator(resource.data.schoolId) || isDistrictAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Teams ────────────────────────────────────────────────────────────────

    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        isSchoolCoordinator(resource.data.schoolId) ||
        isVenueCoordinator() ||
        isJudge() ||
        isDistrictAdmin() ||
        isSuperAdmin()
      );
      // District admins (or super admins) can also create teams for any school they manage
      allow create: if isAuthenticated() && (
        isSchoolCoordinator(request.resource.data.schoolId) ||
        isDistrictAdmin()
      ) &&
        request.resource.data.createdBy == uid() &&
        exists(/databases/$(database)/documents/seasons/$(request.resource.data.seasonId)) &&
        get(/databases/$(database)/documents/seasons/$(request.resource.data.seasonId)).data.phase == 'REGISTRATION_OPEN';
      // Allow updates by district admins or super admins (cloud functions still can do it too)
      allow update: if isDistrictAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /teamMemberships/{membershipId} {
      allow read: if isAuthenticated() && (isVenueCoordinator() || isJudge());
      allow write: if false; // Cloud Functions only
    }

    // ─── Registrations ────────────────────────────────────────────────────────

    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        isSchoolCoordinator(resource.data.schoolId) || isDistrictAdmin()
      );
      allow create: if false; // Cloud Functions: submitRegistration
      allow update: if false; // Cloud Functions only (approve/reject/correction)
      allow delete: if isSuperAdmin();
    }

    match /stageEntries/{entryId} {
      allow read: if isAuthenticated() && (
        isVenueCoordinator() || isJudge() || isDistrictAdmin()
      );
      allow write: if false; // Cloud Functions only
    }

    // ─── Attendance ───────────────────────────────────────────────────────────

    match /studentAttendance/{attendanceId} {
      allow read: if isAuthenticated() && (isVenueCoordinator() || isDistrictAdmin());
      allow write: if false; // Cloud Functions: recordStudentAttendance
    }

    match /trainingSessions/{sessionId} {
      allow read: if isAuthenticated() && (isVenueCoordinator() || isDistrictAdmin());
      allow write: if isDistrictAdmin();
    }

    match /trainingAttendance/{attendanceId} {
      allow read: if isAuthenticated() && (isVenueCoordinator() || isDistrictAdmin());
      allow write: if false; // Cloud Functions: markTrainingAttendance / correctTrainingAttendance
    }

    // ─── Scheduling ───────────────────────────────────────────────────────────

    match /timeSlots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isDistrictAdmin();
    }

    match /slotAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    match /judgeAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == uid() || isDistrictAdmin()
      );
      allow write: if isDistrictAdmin();
    }

    // ─── Scoring ──────────────────────────────────────────────────────────────

    // Judges read their own scorecards; head judges/admins read all
    match /scorecards/{scorecardId} {
      allow read: if isAuthenticated() && (
        resource.data.judgeUid == uid() || isHeadJudge()
      );
      allow create: if isJudge() &&
        request.resource.data.judgeUid == uid() &&
        request.resource.data.status == 'DRAFT';
      allow update: if false; // Cloud Functions: submitScorecard, verifyAndLockScores
      allow delete: if false;
    }

    match /timedRuns/{runId} {
      allow read: if isAuthenticated() && (isJudge() || isDistrictAdmin());
      allow write: if false; // Cloud Functions only
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated() && (isJudge() || isVenueCoordinator());
      allow write: if false; // Cloud Functions only (recordMatchBout)
    }

    match /matchBouts/{boutId} {
      allow read: if isAuthenticated() && (isJudge() || isDistrictAdmin());
      allow write: if false; // Cloud Functions only
    }

    // ─── Payments (NO gateway — coordinator-verified only) ────────────────────

    match /feeRules/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSchoolCoordinator(resource.data.schoolId) || isVenueCoordinator()
      );
      allow write: if false; // Cloud Functions only
    }

    match /payments/{paymentId} {
      // School coordinators can READ their payment status but NOT write
      allow read: if isAuthenticated() && (
        isSchoolCoordinator(resource.data.schoolId) || isVenueCoordinator()
      );
      allow write: if false; // ONLY trusted Cloud Functions: recordManualPayment, verifyManualPayment
    }

    match /paymentAdjustments/{id} {
      allow read: if isVenueCoordinator();
      allow write: if false; // Cloud Functions only: voidOrCorrectPayment
    }

    // ─── Adjustments ──────────────────────────────────────────────────────────

    match /teamAdjustmentRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.requestedBy == uid() || isDistrictAdmin() || isVenueCoordinator()
      );
      allow create: if isVenueCoordinator() || isSchoolCoordinator(request.resource.data.schoolId);
      allow update: if false; // Cloud Functions: approveTeamAdjustment
      allow delete: if false;
    }

    match /teamAdjustmentHistory/{historyId} {
      allow read: if isDistrictAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ─── CSV Import ───────────────────────────────────────────────────────────

    match /importJobs/{jobId} {
      allow read: if isAuthenticated() && (
        resource.data.uploaderUid == uid() || isDistrictAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.uploaderUid == uid();
      allow update: if false; // Cloud Functions only
      allow delete: if isSuperAdmin();
    }

    // ─── Qualifications ───────────────────────────────────────────────────────

    match /qualifications/{qualificationId} {
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        isSchoolCoordinator(resource.data.schoolId)
      );
      allow write: if false; // Cloud Functions: approveQualifiers
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == uid();
      allow write: if false; // Cloud Functions only
    }

    // ─── Audit Logs (immutable — no client writes ever) ───────────────────────

    match /auditLogs/{logId} {
      allow read: if isDistrictAdmin();
      allow write: if false; // NEVER allow client writes to audit logs
    }

    // ─── Config (admin-only writes) ───────────────────────────────────────────

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /seasonCategories/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /arenas/{arenaId} {
      allow read: if isAuthenticated();
      allow write: if isDistrictAdmin();
    }

    // Super admin full fallback
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
